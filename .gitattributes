# Normalise line endings so the same repository builds identically on macOS,
# Linux CI agents and Windows.
* text=auto eol=lf

*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.java    text eol=lf
*.xml     text eol=lf
*.html    text eol=lf
*.md      text eol=lf
Dockerfile   text eol=lf
Jenkinsfile  text eol=lf

*.jar     binary
*.war     binary
*.png     binary
*.jpg     binary
*.pdf     binary
*.xlsx    binary

# Keep generated reports out of diffs
evidence/**/*.xml -diff
