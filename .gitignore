# ---- Maven / Java build output -------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# ---- IDE -----------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
nbproject/
.apt_generated/

# ---- OS ------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ---- Application runtime data (must never be committed) ------------------
# The H2 database lives on a Docker named volume in every real environment;
# these files only appear when the app is run directly on a developer machine.
*.mv.db
*.trace.db
*.lock.db
data/
logs/
*.log
# ...but the curated evidence under evidence/ IS the submission's proof that the
# pipeline really ran, so those logs are version-controlled deliberately.
!evidence/**/*.log
!evidence/**/*.txt
!evidence/**/*.xml

# ---- Test and tool output ------------------------------------------------
# Selenium failure screenshots and generated reports are regenerated by the
# pipeline. Only the curated copies under evidence/ are version-controlled.
surefire-reports/
failsafe-reports/
screenshots/
.selenium/
selenium-manager/

# ---- Secrets -------------------------------------------------------------
# Registry and Docker Hub credentials are supplied by Jenkins credential
# bindings or by the environment, never by a file in the repository.
*.pem
*.key
*.p12
*.jks
.env
.env.*
!.env.example
secrets/
ansible/*.vault
ansible/vault_pass*

# ---- Local overrides -----------------------------------------------------
application-local.yml
application-local.properties
scripts/local-*.sh
