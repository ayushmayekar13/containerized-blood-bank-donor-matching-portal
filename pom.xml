<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.bloodbank</groupId>
  <artifactId>bloodbank-portal</artifactId>
  <version>1.0.0</version>
  <!-- WAR, not JAR: the subject task sheet names Tomcat as the deployment target.
       Spring Boot's WAR is also executable, so the same artefact runs with
       `java -jar`, inside a standalone Tomcat, and inside the Docker image. -->
  <packaging>war</packaging>

  <name>Blood Bank Donor Matching Portal</name>
  <description>Containerized donor matching portal - DevOps project, BE CMPN A, 23102A0018</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Integration (Selenium) tests live in a separate source root so that the
         fast unit suite is never slowed down by a browser. -->
    <it.source.directory>${project.basedir}/src/it/java</it.source.directory>
    <app.base.url>http://localhost:9090</app.base.url>
    <selenium.headless>true</selenium.headless>
    <selenium.version>4.25.0</selenium.version>
  </properties>

  <dependencies>
    <!-- web + server-rendered views -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.thymeleaf.extras</groupId>
      <artifactId>thymeleaf-extras-springsecurity6</artifactId>
    </dependency>

    <!-- persistence -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- validation, security, health -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Tomcat is `provided`: the container supplies it when the WAR is
         deployed, and Spring Boot still embeds it for `java -jar`. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-tomcat</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Selenium 4 for the UI journeys. No chromedriver binary is committed and
         no version is pinned: Selenium Manager, built in since 4.6, detects the
         installed Chrome and downloads the matching driver. A pinned driver in
         the repository rots the moment Chrome auto-updates, which is the most
         common reason a UI suite that used to work stops working. -->
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Deterministic artefact name: the Jenkins job, the Dockerfile and the
         Ansible playbook all refer to target/bloodbank.war -->
    <finalName>bloodbank</finalName>

    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <configuration>
          <!-- No src/main/webapp in a Spring Boot application; views are
               Thymeleaf templates on the classpath. -->
          <failOnMissingWebXml>false</failOnMissingWebXml>
        </configuration>
      </plugin>

      <!-- Fast unit tests: every *Test class under src/test/java -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      The Selenium journeys live in their own profile, and that is a deliberate
      design decision rather than a convenience.

      `mvn clean verify` must be green on any machine, from a clean checkout,
      with nothing else running - that is requirement US-10 and it is what the
      Jenkins Unit Test stage relies on. The UI journeys cannot satisfy that:
      they need a *deployed* application to drive and a browser to drive it with.
      Making them part of the default build would mean the default build fails
      for a reason that has nothing to do with the commit under test, and the
      usual response to that is for people to stop trusting the build.

      So:
        mvn clean verify              unit tests only, always runnable
        mvn clean verify -P ui-tests  UI journeys, against a deployed instance

      The Jenkins pipeline deploys first and then activates this profile, which
      is exactly the ordering the quality gate in Task 10 depends on.
    -->
    <profile>
      <id>ui-tests</id>
      <build>
        <plugins>
          <!-- src/it/java is a separate source root so the fast unit suite is
               never slowed down by a browser, and so the two kinds of test
               cannot be confused for one another. -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.0</version>
            <executions>
              <execution>
                <id>add-integration-test-source</id>
                <phase>generate-test-sources</phase>
                <goals>
                  <goal>add-test-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>${it.source.directory}</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
              <systemPropertyVariables>
                <app.base.url>${app.base.url}</app.base.url>
                <selenium.headless>${selenium.headless}</selenium.headless>
              </systemPropertyVariables>
              <!-- The journeys drive one shared application instance, so they
                   must not run in parallel: two browsers racing on the same
                   blood request would make failures depend on timing rather
                   than on the code. -->
              <forkCount>1</forkCount>
              <reuseForks>true</reuseForks>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <!-- `verify` is what turns a failed journey into a failed
                       build. Without it, failsafe records the failure and the
                       build still goes green - which is precisely the hole the
                       Task 10 quality gate must not have. -->
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
